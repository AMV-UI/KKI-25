digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Root [fillcolor=gold, fontcolor=black, fontsize=9, label="Root\ntype", shape=parallelogram, style=filled];
"Initialize Blackboard" [fillcolor=gray, fontcolor=black, fontsize=9, label="Initialize Blackboard", shape=ellipse, style=filled];
Root -> "Initialize Blackboard";
Sensors [fillcolor=gold, fontcolor=black, fontsize=9, label="Sensors\ntype", shape=parallelogram, style=filled];
Root -> Sensors;
"Heading Subscriber" [fillcolor=gray, fontcolor=black, fontsize=9, label="Heading Subscriber", shape=ellipse, style=filled];
Sensors -> "Heading Subscriber";
"Detected Subscriber" [fillcolor=gray, fontcolor=black, fontsize=9, label="Detected Subscriber", shape=ellipse, style=filled];
Sensors -> "Detected Subscriber";
"PX Mode Subscriber" [fillcolor=gray, fontcolor=black, fontsize=9, label="PX Mode Subscriber", shape=ellipse, style=filled];
Sensors -> "PX Mode Subscriber";
"Mission Control" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Mission Control", shape=box, style=filled];
Root -> "Mission Control";
"Check PX Mode" [fillcolor=gray, fontcolor=black, fontsize=9, label="Check PX Mode", shape=ellipse, style=filled];
"Mission Control" -> "Check PX Mode";
"Mission Selection" [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission Selection", shape=octagon, style=filled];
"Mission Control" -> "Mission Selection";
"Is Find Step One" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Find Step One", shape=ellipse, style=filled];
"Mission Selection" -> "Is Find Step One";
"Mission Find Step One" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission Find Step One", shape=ellipse, style=filled];
"Is Find Step One" -> "Mission Find Step One";
"Is Step One" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Step One", shape=ellipse, style=filled];
"Mission Selection" -> "Is Step One";
"Mission Step One" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission Step One", shape=ellipse, style=filled];
"Is Step One" -> "Mission Step One";
"Is Find Step Two" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Find Step Two", shape=ellipse, style=filled];
"Mission Selection" -> "Is Find Step Two";
"Mission Find Step Two" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission Find Step Two", shape=ellipse, style=filled];
"Is Find Step Two" -> "Mission Find Step Two";
"Is Step Two" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Step Two", shape=ellipse, style=filled];
"Mission Selection" -> "Is Step Two";
"Mission Step Two" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission Step Two", shape=ellipse, style=filled];
"Is Step Two" -> "Mission Step Two";
"Is Find Step Three" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Find Step Three", shape=ellipse, style=filled];
"Mission Selection" -> "Is Find Step Three";
"Mission Find Step Three" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission Find Step Three", shape=ellipse, style=filled];
"Is Find Step Three" -> "Mission Find Step Three";
"Is Step Three" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Step Three", shape=ellipse, style=filled];
"Mission Selection" -> "Is Step Three";
"Mission Step Three" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission Step Three", shape=ellipse, style=filled];
"Is Step Three" -> "Mission Step Three";
"Is Manuver" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Manuver", shape=ellipse, style=filled];
"Mission Selection" -> "Is Manuver";
"Mission Manuver" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission Manuver", shape=ellipse, style=filled];
"Is Manuver" -> "Mission Manuver";
"Is Position Green Box" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Is Position Green Box", shape=ellipse, style=filled];
"Mission Selection" -> "Is Position Green Box";
"Position Green Box" [fillcolor=gray, fontcolor=black, fontsize=9, label="Position Green Box", shape=ellipse, style=filled];
"Is Position Green Box" -> "Position Green Box";
}

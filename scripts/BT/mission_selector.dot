digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
"Mission Selector" [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission Selector", shape=octagon, style=filled];
"Patrol Mission" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Patrol Mission", shape=box, style=filled];
"Mission Selector" -> "Patrol Mission";
Patrol [fillcolor=gray, fontcolor=black, fontsize=9, label=Patrol, shape=ellipse, style=filled];
"Patrol Mission" -> Patrol;
"Docking Mission" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Docking Mission", shape=box, style=filled];
"Mission Selector" -> "Docking Mission";
Docking [fillcolor=gray, fontcolor=black, fontsize=9, label=Docking, shape=ellipse, style=filled];
"Docking Mission" -> Docking;
}

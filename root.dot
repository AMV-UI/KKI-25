digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Root [fillcolor=gold, fontcolor=black, fontsize=9, label="⚡ Root\nSuccessOnAll", shape=parallelogram, style=filled];
Init [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Init", shape=box, style=filled];
Root -> Init;
InitBlackboard [fillcolor=gray, fontcolor=black, fontsize=9, label=InitBlackboard, shape=ellipse, style=filled];
Init -> InitBlackboard;
px_heading_subscriber [fillcolor=gray, fontcolor=black, fontsize=9, label=px_heading_subscriber, shape=ellipse, style=filled];
Init -> px_heading_subscriber;
Tasks [fillcolor=cyan, fontcolor=black, fontsize=9, label=Tasks, shape=octagon, style=filled];
Root -> Tasks;
"is manual moving?" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="is manual moving?", shape=ellipse, style=filled];
Tasks -> "is manual moving?";
ManualMovement [fillcolor=gray, fontcolor=black, fontsize=9, label=ManualMovement, shape=ellipse, style=filled];
"is manual moving?" -> ManualMovement;
"Mission Sequence" [fillcolor=orange, fontcolor=black, fontsize=9, label="Mission Sequence", shape=box, style=filled];
Tasks -> "Mission Sequence";
"Mission1 Success Check" [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission1 Success Check", shape=octagon, style=filled];
"Mission Sequence" -> "Mission1 Success Check";
Mission1 [fillcolor=gray, fontcolor=black, fontsize=9, label=Mission1, shape=ellipse, style=filled];
"Mission1 Success Check" -> Mission1;
"Mission1 Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission1 Fallback", shape=ellipse, style=filled];
"Mission1 Success Check" -> "Mission1 Fallback";
"Mission2 Success Check" [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission2 Success Check", shape=octagon, style=filled];
"Mission Sequence" -> "Mission2 Success Check";
Mission2 [fillcolor=gray, fontcolor=black, fontsize=9, label=Mission2, shape=ellipse, style=filled];
"Mission2 Success Check" -> Mission2;
"Mission2 Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission2 Fallback", shape=ellipse, style=filled];
"Mission2 Success Check" -> "Mission2 Fallback";
"Mission3 Success Check" [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission3 Success Check", shape=octagon, style=filled];
"Mission Sequence" -> "Mission3 Success Check";
Mission3 [fillcolor=gray, fontcolor=black, fontsize=9, label=Mission3, shape=ellipse, style=filled];
"Mission3 Success Check" -> Mission3;
"Mission3 Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission3 Fallback", shape=ellipse, style=filled];
"Mission3 Success Check" -> "Mission3 Fallback";
Idle [fillcolor=gray, fontcolor=black, fontsize=9, label=Idle, shape=ellipse, style=filled];
Tasks -> Idle;
BlackboardMonitor [fillcolor=gray, fontcolor=black, fontsize=9, label=BlackboardMonitor, shape=ellipse, style=filled];
Root -> BlackboardMonitor;
}

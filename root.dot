digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Root [fillcolor=gold, fontcolor=black, fontsize=9, label="⚡ Root\nSuccessOnAll", shape=parallelogram, style=filled];
Tasks [fillcolor=cyan, fontcolor=black, fontsize=9, label=Tasks, shape=octagon, style=filled];
Root -> Tasks;
"Mission Sequence" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Mission Sequence", shape=box, style=filled];
Tasks -> "Mission Sequence";
Mission1 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission1", shape=octagon, style=filled];
"Mission Sequence" -> Mission1;
"Straight Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Straight Execution", shape=ellipse, style=filled];
Mission1 -> "Straight Execution";
"Straight Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Straight Fallback", shape=ellipse, style=filled];
Mission1 -> "Straight Fallback";
Mission2 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission2", shape=octagon, style=filled];
"Mission Sequence" -> Mission2;
"Stall Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Stall Execution", shape=ellipse, style=filled];
Mission2 -> "Stall Execution";
"Stall Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Stall Fallback", shape=ellipse, style=filled];
Mission2 -> "Stall Fallback";
Mission3 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission3", shape=octagon, style=filled];
"Mission Sequence" -> Mission3;
"Turn Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Turn Execution", shape=ellipse, style=filled];
Mission3 -> "Turn Execution";
"Turn Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Turn Fallback", shape=ellipse, style=filled];
Mission3 -> "Turn Fallback";
Mission4 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission4", shape=octagon, style=filled];
"Mission Sequence" -> Mission4;
"Stall Execution*" [fillcolor=gray, fontcolor=black, fontsize=9, label="Stall Execution*", shape=ellipse, style=filled];
Mission4 -> "Stall Execution*";
"Stall Fallback*" [fillcolor=gray, fontcolor=black, fontsize=9, label="Stall Fallback*", shape=ellipse, style=filled];
Mission4 -> "Stall Fallback*";
Mission5 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission5", shape=octagon, style=filled];
"Mission Sequence" -> Mission5;
"Go Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Go Execution", shape=ellipse, style=filled];
Mission5 -> "Go Execution";
"Go Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Go Fallback", shape=ellipse, style=filled];
Mission5 -> "Go Fallback";
Mission6 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission6", shape=octagon, style=filled];
"Mission Sequence" -> Mission6;
"Done Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Done Execution", shape=ellipse, style=filled];
Mission6 -> "Done Execution";
"Done Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Done Fallback", shape=ellipse, style=filled];
Mission6 -> "Done Fallback";
}

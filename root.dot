digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Root [fillcolor=gold, fontcolor=black, fontsize=9, label="⚡ Root\nSuccessOnAll", shape=parallelogram, style=filled];
Tasks [fillcolor=cyan, fontcolor=black, fontsize=9, label=Tasks, shape=octagon, style=filled];
Root -> Tasks;
"Mission Sequence" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Mission Sequence", shape=box, style=filled];
Tasks -> "Mission Sequence";
Mission1 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission1", shape=octagon, style=filled];
"Mission Sequence" -> Mission1;
"Mission 1 Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission 1 Execution", shape=ellipse, style=filled];
Mission1 -> "Mission 1 Execution";
"Mission 1 Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission 1 Fallback", shape=ellipse, style=filled];
Mission1 -> "Mission 1 Fallback";
Mission2 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission2", shape=octagon, style=filled];
"Mission Sequence" -> Mission2;
"Mission 2 Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission 2 Execution", shape=ellipse, style=filled];
Mission2 -> "Mission 2 Execution";
"Mission 2 Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission 2 Fallback", shape=ellipse, style=filled];
Mission2 -> "Mission 2 Fallback";
Mission3 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission3", shape=octagon, style=filled];
"Mission Sequence" -> Mission3;
"Mission 3 Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission 3 Execution", shape=ellipse, style=filled];
Mission3 -> "Mission 3 Execution";
"Mission 3 Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Mission 3 Fallback", shape=ellipse, style=filled];
Mission3 -> "Mission 3 Fallback";
Mission4 [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Mission4", shape=octagon, style=filled];
"Mission Sequence" -> Mission4;
"Docking Mission Execution" [fillcolor=gray, fontcolor=black, fontsize=9, label="Docking Mission Execution", shape=ellipse, style=filled];
Mission4 -> "Docking Mission Execution";
"Docking Mission Fallback" [fillcolor=gray, fontcolor=black, fontsize=9, label="Docking Mission Fallback", shape=ellipse, style=filled];
Mission4 -> "Docking Mission Fallback";
}

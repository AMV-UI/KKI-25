digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Root [label="⚡ Root\nSuccessOnAll", shape=parallelogram, style=filled, fillcolor=gold, fontsize=9, fontcolor=black];
Tasks [label=Tasks, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
Root -> Tasks;
"Mission Sequence" [label="Mission Sequence", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
Tasks -> "Mission Sequence";
Mission1 [label=Mission1, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission1;
"Mission1 Execution" [label="Mission1 Execution", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission1 -> "Mission1 Execution";
"Mission1 Fallback" [label="Mission1 Fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission1 -> "Mission1 Fallback";
Mission2 [label=Mission2, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission2;
"Mission2 Execution" [label="Mission2 Execution", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission2 -> "Mission2 Execution";
"Mission2 Fallback" [label="Mission2 Fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission2 -> "Mission2 Fallback";
}

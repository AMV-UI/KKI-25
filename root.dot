digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Root [label="⚡ Root\nSuccessOnAll", shape=parallelogram, style=filled, fillcolor=gold, fontsize=9, fontcolor=black];
Tasks [label=Tasks, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
Root -> Tasks;
"Mission Sequence" [label="Ⓜ Mission Sequence", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
Tasks -> "Mission Sequence";
Mission1 [label="Ⓜ Mission1", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission1;
"Straight Execution" [label="Straight Execution", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission1 -> "Straight Execution";
"Straight Fallback" [label="Straight Fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission1 -> "Straight Fallback";
Mission2 [label="Ⓜ Mission2", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission2;
"Stall Execution" [label="Stall Execution", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission2 -> "Stall Execution";
"Stall Fallback" [label="Stall Fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission2 -> "Stall Fallback";
Mission3 [label="Ⓜ Mission3", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission3;
"Turn Execution" [label="Turn Execution", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission3 -> "Turn Execution";
"Turn Fallback" [label="Turn Fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission3 -> "Turn Fallback";
Mission4 [label="Ⓜ Mission4", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission4;
"Stall Execution*" [label="Stall Execution*", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission4 -> "Stall Execution*";
"Stall Fallback*" [label="Stall Fallback*", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission4 -> "Stall Fallback*";
Mission5 [label="Ⓜ Mission5", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission5;
"Go Execution" [label="Go Execution", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission5 -> "Go Execution";
"Go Fallback" [label="Go Fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission5 -> "Go Fallback";
Mission6 [label="Ⓜ Mission6", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Mission Sequence" -> Mission6;
"Done Execution" [label="Done Execution", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission6 -> "Done Execution";
"Done Fallback" [label="Done Fallback", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Mission6 -> "Done Fallback";
}
